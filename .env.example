# Copy to .env and fill in from Supabase → Project Settings → API.
# Only the URL and the anon (public) key go in the app. Never the service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat → Project → API keys → the public iOS key (starts with appl_). Public by design, like the anon key.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# RevenueCat → Project → API keys → the public Web Billing key (for the web app, paid with Stripe)
EXPO_PUBLIC_REVENUECAT_WEB_KEY=
