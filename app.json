{
  "expo": {
    "name": "Hilo",
    "slug": "hilo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hilo",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arnolop.hilo",
      "infoPlist": {
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "NSPhotoLibraryUsageDescription": "Para añadir fotos a las historias de su libro. Solo las ve tu familia."
      },
      "requireFullScreen": true,
      "buildNumber": "27"
    },
    "android": {
      "package": "com.arnolop.hilo",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["react-native-libsodium", {}],
      [
        "expo-image-picker",
        {
          "photosPermission": "Para añadir fotos a las historias de su libro. Solo las ve tu familia.",
          "cameraPermission": "Hilo usa la cámara para leer el código QR que te da tu familia y para fotografiar documentos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Hilo usa la cámara para leer el código QR que te da tu familia y para fotografiar documentos.",
          "microphonePermission": "Hilo usa el micrófono para escucharte cuando hablas con Hilo y en las llamadas con tu familia.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Hilo usa el micrófono para escucharte cuando hablas con Hilo y en las llamadas con tu familia.",
          "speechRecognitionPermission": "Hilo convierte lo que cuentas en texto para guardarlo en tu libro."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Hilo usa el micrófono para escucharte cuando hablas con Hilo y en las llamadas con tu familia."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "es",
              "en",
              "nl"
            ]
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "@config-plugins/react-native-callkeep",
      "@livekit/react-native-expo-plugin",
      ["@config-plugins/react-native-webrtc", { "microphonePermission": "Hilo usa el micrófono para escucharte cuando hablas con Hilo y en las llamadas con tu familia." }],
      "./plugins/with-call-icon"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json",
      "nl": "./locales/nl.json"
    }
  }
}
