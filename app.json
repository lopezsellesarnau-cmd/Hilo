{
  "expo": {
    "name": "Hilo",
    "slug": "hilo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hilo",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arnolop.hilo",
      "infoPlist": {
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown"
        ],
        "NSPhotoLibraryUsageDescription": "Hilo no usa tus fotos. Si algún día lo necesita, te lo preguntará antes."
      },
      "requireFullScreen": true,
      "buildNumber": "2"
    },
    "android": {
      "package": "com.arnolop.hilo",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Hilo usa la cámara para leer el código QR que te da tu familia.",
          "microphonePermission": "Hilo usa el micrófono para escucharte cuando tocas el botón para hablar.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Hilo usa el micrófono para escucharte cuando tocas el botón para hablar.",
          "speechRecognitionPermission": "Hilo convierte lo que cuentas en texto para guardarlo en tu libro."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Hilo usa el micrófono para escucharte cuando tocas el botón para hablar."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
