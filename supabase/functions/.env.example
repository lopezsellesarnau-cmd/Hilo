# Secrets for the Edge Functions. They live in Supabase → Edge Functions → Secrets, never in the app.
# For local runs: copy to supabase/functions/.env and fill in.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase: don't set them.

# talk: Claude (workspace "Hilo" in the Anthropic console)
ANTHROPIC_API_KEY=

# talk: voice. azure (default) or elevenlabs
VOICE_PROVIDER=azure

# Azure Speech, tier F0, EU region
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=es-ES-XimenaMultilingualNeural

# ElevenLabs, only if VOICE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
