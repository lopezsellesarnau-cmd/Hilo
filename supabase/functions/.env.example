# Secrets for the Edge Functions. They live in Supabase → Edge Functions → Secrets, never in the app.
# For local runs: copy to supabase/functions/.env and fill in.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase: don't set them.

# talk: Claude (workspace "Hilo" in the Anthropic console)
ANTHROPIC_API_KEY=

# talk: voice. azure (default) or elevenlabs
VOICE_PROVIDER=azure

# Azure Speech, tier F0, EU region
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=es-ES-XimenaMultilingualNeural
# Optional: the voice for people.locale = nl / en (defaults: nl-NL-FennaNeural, en-GB-SoniaNeural)
AZURE_SPEECH_VOICE_NL=
AZURE_SPEECH_VOICE_EN=

# ElevenLabs, only if VOICE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# quiet-alert: Supabase Cron sends this in the x-cron-secret header (any long random string)
CRON_SECRET=

# quiet-alert: Apple push key (developer.apple.com → Keys → Apple Push Notifications service)
# APNS_KEY is the whole .p8 file, with its BEGIN/END lines
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.arnolop.hilo
